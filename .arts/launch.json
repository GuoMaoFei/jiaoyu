{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🐍 Backend: FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "⚛️ Frontend: Vite",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "🚀 Backend + Frontend (同时启动)",
      "type": "composite",
      "dependsOn": ["🐍 Backend: FastAPI (uvicorn)", "⚛️ Frontend: Vite"],
      "preLaunchTask": null,
      "stopAll": true
    }
  ]
}
